        private void iUpdateBtn_Click_1(object sender, EventArgs e)
        {
            string newName = iNameEditTextBox.Text.Trim();
            string newEmail = iEmailEditTextBox.Text.Trim();
            string newProfession = iProfessionEditTextBox.Text.Trim();
            string newOrganization = iOrganizationEditTextBox.Text.Trim();
            string newBio = iBioEditTextBox.Text.Trim();

            if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newEmail) || string.IsNullOrWhiteSpace(newProfession) || string.IsNullOrWhiteSpace(newOrganization) || string.IsNullOrWhiteSpace(newBio))
            {
                MessageBox.Show("All fields must be filled out.", "Validation Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string query1 = "UPDATE Users SET Name = @Name, Email = @Email WHERE UserID = @Id";
            string query2 = "SELECT COUNT(*) FROM InvestorProfile WHERE UserID = @Id";


            using (SqlConnection connection = new SqlConnection(connectionString))
            {
                using (SqlCommand command = new SqlCommand(query1, connection))
                {
                    command.Parameters.AddWithValue("@Id", userID);
                    command.Parameters.AddWithValue("@Name", newName);
                    command.Parameters.AddWithValue("@Email", newEmail);

                    connection.Open();
                    int rowsAffected = command.ExecuteNonQuery();

                    if (rowsAffected > 0)
                    {
                        using (SqlCommand checkCmd = new SqlCommand(query2, connection))
                        {
                            checkCmd.Parameters.AddWithValue("@Id", userID);
                            int count = (int)checkCmd.ExecuteScalar();

                            string query3; ;

                            if (count > 0)
                            {
                                query3 = "UPDATE InvestorProfile SET Profession = @Profession, Organization = @Organization, ShortIntro = @ShortIntro WHERE UserID = @Id";
                            }
                            else
                            {
                                query3 = "INSERT INTO InvestorProfile (UserID, Profession, Organization, ShortIntro) VALUES (@Id, @Profession, @Organization, @ShortIntro)";
                            }

                            using (SqlCommand command2 = new SqlCommand(query3, connection))
                            {
                                command2.Parameters.AddWithValue("@Id", userID);
                                command2.Parameters.AddWithValue("@Profession", newProfession);
                                command2.Parameters.AddWithValue("@Organization", newOrganization);
                                command2.Parameters.AddWithValue("@ShortIntro", newBio);
                                command2.ExecuteNonQuery();
                            }
                        }
                        //MessageBox.Show("Record updated successfully!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                        //Close(); // Optionally close the form after a successful update
                        iUpdateMessageDialog.Show();
                        ProfileForm profileForm1 = new ProfileForm(userID);
                        profileForm1.Show();
                        this.Hide();
                    }
                    else
                    {
                        MessageBox.Show("No record was updated. Please try again.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }

        private void iDeleteBtn_Click_1(object sender, EventArgs e)
        {
            DialogResult result = ideleteProfileMessageDialog.Show();

            if (result == DialogResult.Yes)
            {
                string deleteBids = "DELETE FROM Bids WHERE UserID = @Id";
                string deleteResults = "DELETE FROM Results WHERE UserID = @Id";
                string deleteStartups = "DELETE FROM Startups WHERE UserID = @Id";
                string deleteInvestor = "DELETE FROM InvestorProfile WHERE UserID = @Id";
                string deleteUser = "DELETE FROM Users WHERE UserID = @Id";

                using (SqlConnection connection = new SqlConnection(connectionString))
                {
                    connection.Open();

                    int rowsAffected = 0;

                    using (SqlCommand cmd1 = new SqlCommand(deleteBids, connection))
                    {
                        cmd1.Parameters.AddWithValue("@Id", userID);
                        cmd1.ExecuteNonQuery();
                    }

                    using (SqlCommand cmd2 = new SqlCommand(deleteResults, connection))
                    {
                        cmd2.Parameters.AddWithValue("@Id", userID);
                        cmd2.ExecuteNonQuery();
                    }

                    using (SqlCommand cmd3 = new SqlCommand(deleteStartups, connection))
                    {
                        cmd3.Parameters.AddWithValue("@Id", userID);
                        cmd3.ExecuteNonQuery();
                    }

                    using (SqlCommand cmd4 = new SqlCommand(deleteInvestor, connection))
                    {
                        cmd4.Parameters.AddWithValue("@Id", userID);
                        cmd4.ExecuteNonQuery();
                    }

                    using (SqlCommand cmd5 = new SqlCommand(deleteUser, connection))
                    {
                        cmd5.Parameters.AddWithValue("@Id", userID);
                        rowsAffected = cmd5.ExecuteNonQuery();
                    }

                    if (rowsAffected > 0)
                    {
                        iConfirmDeletionMessageDialog.Show();

                        this.Close();

                        LoginForm login = new LoginForm();
                        login.ShowDialog();
                    }
                    else
                    {
                        MessageBox.Show("No profile was found to delete.",
                            "Error",
                            MessageBoxButtons.OK,
                            MessageBoxIcon.Error);
                    }
                }
            }
        }

